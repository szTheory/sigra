# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
sigra-*.tar

# Temporary files, for example, from tests.
/tmp/

# direnv cache (the committed .envrc is fine; its evaluated cache is not)
.direnv/

# IDE
.elixir_ls/

# OS
.DS_Store

# Example app isolated build artifacts (Phase 10 plan 10-06 / Pitfall 4).
# mix.lock is committed so CI cache keys are deterministic.
test/example/_build/
test/example/deps/

# Local tooling / agent state (never ship in commits).
.claude/
.cursor/
.playwright-mcp/

# Playwright MCP or ad-hoc runs at repo root (not example subproject).
/test-results/

# Local research prompts (not part of the library release).
/prompts/

# Brand toolchain — font binaries and render artifacts (never commit font TTFs).
/scripts/brand/node_modules/
/scripts/brand/fonts/

# Phase 216 (D-04): ephemeral evaluation bundles under the playwright subproject.
# eval/ = per-app-git-sha evidence bundle; playwright-report/ + test-results/ = run artifacts.
test/example/priv/playwright/eval/
test/example/priv/playwright/playwright-report/
test/example/priv/playwright/test-results/

# Phase 217-06 (AUTOFIX-02): admin-autofix-loop persisted poison-set.
# Never-retry finding_ids for the auto-fix loop; operator/nightly tool state.
eval/autofix-state.json
