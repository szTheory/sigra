# direnv config (optional, opt-in via `direnv allow`).
#
# Auto-loads the Dockerized test Postgres connection details written by
# `scripts/db/up.sh` so `mix test` discovers the dynamic host port with zero
# manual steps. `dotenv_if_exists` is a NO-OP when tmp/db.env is absent (CI, or
# before you run scripts/db/up.sh), so connections then fall back to the
# localhost:5432 defaults — nothing breaks.
#
# No direnv? Use the printed fallback instead:  source tmp/db.env && mix test
dotenv_if_exists tmp/db.env
