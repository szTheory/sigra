<.sigra_auth_page flash={@flash} data-testid="app-login-approval">
  <div class="sigra-auth-flow sigra-auth-stack sigra-auth-stack--6">
    <.header>
      Continue to {@profile_name}
      <:subtitle>Review this request before continuing to the app.</:subtitle>
    </.header>

    <section class="sigra-auth-section sigra-auth-stack sigra-auth-stack--4" aria-labelledby="app-login-decision-title">
      <h2 id="app-login-decision-title">Approve app sign-in</h2>
      <p>This will continue your signed-in browser session to {@profile_name}.</p>

      <div class="sigra-auth-stack sigra-auth-stack--3" data-testid="app-login-decision-controls">
        <form action={~p"/users/app-login/approve"} method="post">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <.sigra_auth_button class="sigra-auth-action sigra-auth-action--primary sigra-auth-action--block" data-testid="app-login-approve">
            Approve and continue
          </.sigra_auth_button>
        </form>

        <form action={~p"/users/app-login/cancel"} method="post">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <.sigra_auth_button class="sigra-auth-action sigra-auth-action--secondary sigra-auth-action--block" data-testid="app-login-cancel">
            Cancel
          </.sigra_auth_button>
        </form>
      </div>
    </section>
  </div>
</.sigra_auth_page>
