<Layouts.flash_group flash={@flash} />
<link phx-track-static rel="stylesheet" href={~p"/assets/sigra_auth.css"} />

<main class="vt-home">
  <div class="vt-home__shell" data-testid="home-evaluator-doorway">
    <header class="vt-topline" aria-label="Tasklane demo identity">
      <a href="/" class="vt-brand">
        <img
          src={~p"/images/tasklane-mark.svg"}
          width="36"
          height="36"
          alt=""
          class="vt-brand__mark"
        />
        <span>
          <span class="vt-brand__name">Tasklane</span>
          <span class="vt-brand__tag">Work tracking for teams</span>
        </span>
      </a>

      <div class="vt-domain-strip" data-testid="home-domain-context">
        <span class="vt-domain-strip__label">Cohort</span>
        <code class="vt-code">{"@" <> @demo_domain}</code>
        <span class="vt-domain-strip__label">Local host</span>
        <code class="vt-code">{@local_origin}</code>
      </div>
    </header>

    <section class="vt-hero">
      <div class="vt-hero__copy">
        <p class="vt-kicker">Tasklane demo app · secured by Sigra</p>
        <h1 class="vt-title">Evaluate Sigra inside a distinct customer app.</h1>
        <p class="vt-subtitle">
          Tasklane is a fictional <strong>project tracker</strong> — teams plan and ship
          work together across shared workspaces. Its sign-in, organizations, audit
          trails, and operator tooling are all powered by Sigra underneath; the product
          itself (boards and tasks) is out of scope for this auth demo. The seeded
          Tasklane cohort lets evaluators inspect customer sign-in and support workflows
          without creating accounts.
        </p>

        <div class="vt-identity-grid">
          <div class="vt-identity-item">
            <span>Tasklane cohort domain</span>
            <strong>{"@" <> @demo_domain}</strong>
          </div>
          <div class="vt-identity-item">
            <span>Local evaluation host</span>
            <strong>{@local_origin}</strong>
          </div>
          <div class="vt-identity-item">
            <span>Sigra operator surface</span>
            <strong>/admin</strong>
          </div>
        </div>

        <div class="vt-action-row">
          <a :if={is_nil(@current_scope)} href="#get-started" class="vt-btn vt-btn--primary">
            Get started — pick a persona
          </a>
          <a :if={@current_scope} href={~p"/app"} class="vt-btn vt-btn--primary">
            Open your dashboard
          </a>
          <.link
            :if={@current_scope}
            href={~p"/users/log_out"}
            method="delete"
            class="vt-btn vt-btn--ghost"
            data-testid="home-log-out"
          >
            Log out
          </.link>
        </div>
        <p class="vt-copy">
          <a href="/admin" class="vt-link">Open Sigra Admin</a>
          ·
          <a href="/dev/mailbox" class="vt-link">Inspect mailbox</a>
        </p>
      </div>

      <aside
        id="get-started"
        class="vt-panel vt-panel--operator"
        data-testid="home-shared-login-copy"
      >
        <p class="vt-kicker">One login, two jobs.</p>
        <h2 class="vt-panel__title">Sign in as an operator.</h2>
        <p class="vt-copy">Same Tasklane login as customers — operator personas continue into Sigra admin.</p>
        <a href="/demo/credentials" class="vt-btn vt-btn--ghost vt-btn--block">View all 10 personas &rarr;</a>
        <ul class="vt-operator-list">
          <li>
            <div>
              <strong>Global Sigra Admin</strong>
              <p class="vt-copy">Platform-wide operator → <code class="vt-code">/admin</code></p>
            </div>
            <a href={~p"/users/log_in?#{%{demo: "admin"}}"} class="vt-btn vt-btn--primary vt-btn--block">Sign in as Admin</a>
          </li>
          <li>
            <div>
              <strong>Acme org admin</strong>
              <p class="vt-copy">Org-scoped operator → <code class="vt-code">/admin/organizations/acme-corp</code></p>
            </div>
            <a href={~p"/users/log_in?#{%{demo: "morgan"}}"} class="vt-btn vt-btn--primary vt-btn--block">Sign in as Morgan</a>
          </li>
        </ul>
      </aside>
    </section>

    <section
      class="vt-brand-lab"
      data-testid="demo-brand-lab"
      data-demo-brand-surface
      data-demo-brand-presets={@demo_brand_presets_json}
      data-demo-brand-default={@demo_brand_default_id}
      data-demo-brand-theme-default={to_string(@demo_brand_default_theme)}
      data-theme={to_string(@demo_brand_default_theme)}
      style={@demo_brand_default_style}
    >
      <div class="vt-brand-lab__header">
        <div>
          <p class="vt-kicker">White-label preview</p>
          <h2 class="vt-panel__title">Switch the auth brand</h2>
          <p class="vt-copy" data-demo-brand-description>
            {@demo_brand_default_description}
          </p>
        </div>

        <div class="vt-brand-controls">
          <label class="vt-brand-select" for="demo_brand_select">
            <span>Brand preset</span>
            <select id="demo_brand_select" data-demo-brand-select>
              <option
                :for={preset <- @demo_brand_presets}
                value={preset.id}
                selected={preset.id == @demo_brand_default_id}
              >
                {preset.label}
              </option>
            </select>
          </label>

          <fieldset class="vt-theme-control" aria-label="Brand theme">
            <legend>Brand theme</legend>
            <div class="vt-theme-control__options">
              <label :for={theme <- [:system, :light, :dark]}>
                <input
                  type="radio"
                  name="demo_brand_theme"
                  value={to_string(theme)}
                  checked={theme == @demo_brand_default_theme}
                  data-demo-brand-theme
                />
                <span>{String.capitalize(to_string(theme))}</span>
              </label>
            </div>
          </fieldset>
        </div>
      </div>

      <div class="vt-brand-lab__grid">
        <div
          class="sigra-auth sigra-auth--preview"
          data-demo-auth-preview
          data-theme={to_string(@demo_brand_default_theme)}
          style={@demo_brand_default_style}
        >
          <section class="sigra-auth__viewport" aria-label="Auth preview">
            <div class="sigra-auth__panel">
              <div class="sigra-auth__brand">
                <img
                  src={@demo_brand_default_profile.logo_url || ""}
                  alt={
                    if @demo_brand_default_profile.logo_url,
                      do: @demo_brand_default_profile.logo_alt,
                      else: ""
                  }
                  class="sigra-auth__logo"
                  data-demo-brand-logo
                  hidden={is_nil(@demo_brand_default_profile.logo_url)}
                />
                <div
                  class="sigra-auth__mark"
                  aria-hidden="true"
                  data-demo-brand-fallback-mark
                  hidden={not is_nil(@demo_brand_default_profile.logo_url)}
                >
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <p class="sigra-auth__product" data-demo-brand-text="product_name">
                  {@demo_brand_default_profile.product_name}
                </p>
              </div>

              <div>
                <h1>
                  Log in to
                  <span data-demo-brand-text="product_name">
                    {@demo_brand_default_profile.product_name}
                  </span>
                </h1>
                <p>New here? Create an account.</p>
              </div>

              <form aria-label="Auth preview form">
                <input
                  type="email"
                  value="morgan@example.test"
                  aria-label="Email preview"
                  readonly
                />
                <input type="password" value="password" aria-label="Password preview" readonly />
                <button type="button">Log in</button>
              </form>
            </div>
          </section>
        </div>

        <article class="vt-email-preview" data-demo-email-preview>
          <div class="vt-email-preview__chrome">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="vt-email-preview__meta">
            <span>From</span>
            <strong data-demo-brand-text="email_from_name">
              {@demo_brand_default_profile.email_from_name}
            </strong>
            <code class="vt-code" data-demo-brand-text="email_from_address">
              {@demo_brand_default_profile.email_from_address}
            </code>
          </div>
          <h3 data-demo-brand-subject>{@demo_brand_default_subject}</h3>
          <p>
            Finish setting up your
            <span data-demo-brand-text="product_name">
              {@demo_brand_default_profile.product_name}
            </span>
            account. This preview uses the same brand tokens as the generated auth templates.
          </p>
          <span class="vt-email-preview__button">Confirm account</span>
        </article>
      </div>
    </section>

    <section class="vt-panel" aria-label="Seeded evidence">
      <div class="vt-metric-grid">
        <dl class="vt-metric" data-testid="home-stat-personas">
          <dt>Demo personas</dt>
          <dd>{@persona_count}</dd>
        </dl>
        <dl class="vt-metric" data-testid="home-stat-tenants">
          <dt>Organizations</dt>
          <dd>{@tenant_count}</dd>
        </dl>
        <dl class="vt-metric" data-testid="home-stat-audit">
          <dt>Audit rows</dt>
          <dd>{@audit_row_count}</dd>
        </dl>
      </div>

      <div class="vt-panel__header">
        <div>
          <p class="vt-kicker">Seeded evidence</p>
          <h2 class="vt-panel__title">What the Tasklane world proves</h2>
        </div>
      </div>

      <ul class="vt-seed-list">
        <li>
          <strong>Acme Corp</strong>
          and <strong>Beta Labs</strong>
          exercise organization scope, memberships, invitations, and tenant-aware audit rows.
        </li>
        <li>
          <strong>{"@" <> @demo_domain}</strong> is the fixture-only Tasklane cohort domain.
        </li>
        <li>
          <strong>Sigra Admin</strong>
          shows support operations: user search, session review, impersonation, audit filters, exports, and scoped org views.
        </li>
        <li>
          <strong>Org admin path:</strong>
          sign in as <code class="vt-code vt-code--copy">morgan@demo.tasklane.test</code>, then open <a href="/admin/organizations/acme-corp" class="vt-link">/admin/organizations/acme-corp</a>.
        </li>
      </ul>
    </section>
  </div>
</main>
