<Layouts.flash_group flash={@flash} />

<main class="min-h-[calc(100vh-4rem)] bg-base-100 px-4 py-10 sm:px-6 lg:px-8">
  <section class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div class="space-y-6">
      <p class="sg-page-kicker">Vaultr demo app</p>
      <h1 class="sg-page-title text-4xl font-semibold">
        A realistic SaaS auth surface for evaluating Sigra.
      </h1>
      <p class="sg-page-copy text-base text-base-content/70">
        Vaultr is a seed-populated demo tenant with realistic auth states, operator workflows, and audit evidence. Use it to click through the happy path and the rough edges before wiring Sigra into a real app.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/demo/credentials" class="sg-press btn btn-primary min-h-11">
          Open demo personas
        </a>
        <a href="/admin" class="sg-press btn btn-outline min-h-11">
          Open admin
        </a>
        <a href="/dev/mailbox" class="sg-press btn btn-ghost min-h-11">
          Inspect mailbox
        </a>
      </div>
    </div>

    <div class="grid gap-4">
      <article class="sg-card rounded-lg border border-base-300 bg-base-100 p-5">
        <h2 class="text-lg font-semibold">Evaluator journey</h2>
        <ol class="mt-4 space-y-3 text-sm text-base-content/70">
          <li><strong>1.</strong> Pick a persona and sign in with public demo credentials.</li>
          <li><strong>2.</strong> Explore user support, sessions, MFA, passkeys, and organization scope.</li>
          <li><strong>3.</strong> Review audit evidence and exported CSV paths.</li>
        </ol>
      </article>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="sg-metric">
          <dt>Personas</dt>
          <dd>6</dd>
        </div>
        <div class="sg-metric">
          <dt>Tenants</dt>
          <dd>2</dd>
        </div>
        <div class="sg-metric">
          <dt>Audit rows</dt>
          <dd>15+</dd>
        </div>
      </div>
    </div>
  </section>
</main>
