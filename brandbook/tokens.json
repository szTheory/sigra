{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sigra brand tokens",
  "version": "1.0.0",
  "meta": {
    "source": "Derived from Sigra repository voice, launch docs, security posture, and v1.34 admin UI tokens.",
    "policy": "Durable, source-controlled tokens for brandbook, docs, landing pages, and marketing collateral. These tokens do not change generated application UI by themselves.",
    "license": "MIT repository asset; no embedded fonts or proprietary binary assets."
  },
  "raw": {
    "color": {
      "ink": { "value": "#151515" },
      "paper": { "value": "#ffffff" },
      "warm-025": { "value": "#fbfaf7" },
      "warm-050": { "value": "#f6f5f2" },
      "warm-100": { "value": "#ece7df" },
      "warm-700": { "value": "#686868" },
      "ember-050": { "value": "#fff0e8" },
      "ember-300": { "value": "#fdba74" },
      "ember-700": { "value": "#c2410c" },
      "ember-800": { "value": "#9a3412" },
      "green-050": { "value": "#ecfdf3" },
      "green-700": { "value": "#176b43" },
      "yellow-050": { "value": "#fff7e6" },
      "yellow-700": { "value": "#a15c00" },
      "red-050": { "value": "#fff1f0" },
      "red-700": { "value": "#b42318" },
      "blue-050": { "value": "#eef2ff" },
      "blue-700": { "value": "#1d4ed8" },
      "dark-900": { "value": "#171614" },
      "dark-850": { "value": "#1f1d1a" },
      "dark-800": { "value": "#25221e" },
      "dark-text": { "value": "#f4f1eb" },
      "dark-muted": { "value": "#bdb5aa" }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "bg": { "value": "{raw.color.warm-050}" },
        "surface": { "value": "{raw.color.paper}" },
        "surface-alt": { "value": "{raw.color.warm-025}" },
        "text": { "value": "{raw.color.ink}" },
        "text-muted": { "value": "{raw.color.warm-700}" },
        "border": { "value": "rgba(21, 21, 21, 0.10)" },
        "border-strong": { "value": "rgba(21, 21, 21, 0.16)" },
        "accent": { "value": "{raw.color.ember-700}" },
        "accent-strong": { "value": "{raw.color.ember-800}" },
        "accent-soft": { "value": "{raw.color.ember-050}" },
        "on-accent": { "value": "{raw.color.paper}" },
        "success": { "value": "{raw.color.green-700}" },
        "success-soft": { "value": "{raw.color.green-050}" },
        "warning": { "value": "{raw.color.yellow-700}" },
        "warning-soft": { "value": "{raw.color.yellow-050}" },
        "error": { "value": "{raw.color.red-700}" },
        "error-soft": { "value": "{raw.color.red-050}" },
        "info": { "value": "{raw.color.blue-700}" },
        "info-soft": { "value": "{raw.color.blue-050}" },
        "code-bg": { "value": "rgba(21, 21, 21, 0.05)" },
        "code-text": { "value": "{raw.color.warm-700}" },
        "disabled-bg": { "value": "{raw.color.warm-100}" },
        "disabled-text": { "value": "#8a8178" },
        "selected-bg": { "value": "{raw.color.ember-050}" },
        "selected-text": { "value": "{raw.color.ember-800}" },
        "focus": { "value": "color-mix(in oklab, {raw.color.ember-700} 35%, transparent)" }
      }
    },
    "dark": {
      "color": {
        "bg": { "value": "{raw.color.dark-900}" },
        "surface": { "value": "{raw.color.dark-850}" },
        "surface-alt": { "value": "{raw.color.dark-800}" },
        "text": { "value": "{raw.color.dark-text}" },
        "text-muted": { "value": "{raw.color.dark-muted}" },
        "border": { "value": "rgba(255, 255, 255, 0.10)" },
        "border-strong": { "value": "rgba(255, 255, 255, 0.16)" },
        "accent": { "value": "{raw.color.ember-700}" },
        "accent-strong": { "value": "{raw.color.ember-300}" },
        "accent-soft": { "value": "rgba(243, 90, 16, 0.16)" },
        "on-accent": { "value": "{raw.color.paper}" },
        "success": { "value": "#5dd1a0" },
        "success-soft": { "value": "rgba(52, 211, 153, 0.16)" },
        "warning": { "value": "#f5c451" },
        "warning-soft": { "value": "rgba(245, 196, 81, 0.16)" },
        "error": { "value": "#f8a39c" },
        "error-soft": { "value": "rgba(248, 113, 113, 0.16)" },
        "info": { "value": "#9db8f5" },
        "info-soft": { "value": "rgba(120, 150, 245, 0.16)" },
        "code-bg": { "value": "rgba(244, 241, 235, 0.08)" },
        "code-text": { "value": "{raw.color.dark-muted}" },
        "disabled-bg": { "value": "rgba(255, 255, 255, 0.08)" },
        "disabled-text": { "value": "#81786f" },
        "selected-bg": { "value": "rgba(243, 90, 16, 0.16)" },
        "selected-text": { "value": "{raw.color.ember-300}" },
        "focus": { "value": "color-mix(in oklab, {raw.color.ember-300} 36%, transparent)" }
      }
    }
  },
  "typography": {
    "family": {
      "sans": { "value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
      "mono": { "value": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace" }
    },
    "size": {
      "xs": { "value": "0.75rem" },
      "sm": { "value": "0.875rem" },
      "base": { "value": "1rem" },
      "md": { "value": "1.125rem" },
      "lg": { "value": "1.45rem" },
      "xl": { "value": "1.875rem" },
      "hero": { "value": "clamp(2.15rem, 6vw, 4.8rem)" }
    },
    "weight": {
      "regular": { "value": "450" },
      "medium": { "value": "600" },
      "semibold": { "value": "700" },
      "bold": { "value": "800" }
    },
    "lineHeight": {
      "tight": { "value": "1.1" },
      "snug": { "value": "1.3" },
      "normal": { "value": "1.5" },
      "relaxed": { "value": "1.6" }
    }
  },
  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.25rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" }
  },
  "radius": {
    "xs": { "value": "0.375rem" },
    "sm": { "value": "0.5rem" },
    "md": { "value": "0.75rem" },
    "full": { "value": "999px" }
  },
  "border": {
    "thin": { "value": "1px solid var(--sigra-border)" },
    "strong": { "value": "1px solid var(--sigra-border-strong)" },
    "attention": { "value": "3px solid currentColor" }
  },
  "shadow": {
    "inset": { "value": "inset 0 0 0 1px var(--sigra-border)" },
    "panel": { "value": "0 0 0 1px rgba(21,21,21,0.06), 0 1px 2px -1px rgba(21,21,21,0.08), 0 10px 30px -24px rgba(21,21,21,0.35)" },
    "lift": { "value": "0 0 0 1px rgba(21,21,21,0.10), 0 3px 10px -8px rgba(21,21,21,0.35), 0 18px 44px -30px rgba(21,21,21,0.45)" }
  },
  "motion": {
    "fast": { "value": "140ms" },
    "medium": { "value": "220ms" },
    "ease": { "value": "cubic-bezier(0.2, 0, 0, 1)" },
    "ease-out": { "value": "cubic-bezier(0.23, 1, 0.32, 1)" }
  },
  "state": {
    "default": { "bg": "{semantic.light.color.surface}", "text": "{semantic.light.color.text}" },
    "hover": { "bg": "{semantic.light.color.accent-soft}", "text": "{semantic.light.color.accent-strong}" },
    "active": { "transform": "scale(0.98)" },
    "focus": { "ring": "0 0 0 3px var(--sigra-focus)" },
    "disabled": { "opacity": "0.52", "cursor": "not-allowed" },
    "selected": { "bg": "{semantic.light.color.selected-bg}", "text": "{semantic.light.color.selected-text}" },
    "success": { "bg": "{semantic.light.color.success-soft}", "text": "{semantic.light.color.success}" },
    "warning": { "bg": "{semantic.light.color.warning-soft}", "text": "{semantic.light.color.warning}" },
    "error": { "bg": "{semantic.light.color.error-soft}", "text": "{semantic.light.color.error}" },
    "info": { "bg": "{semantic.light.color.info-soft}", "text": "{semantic.light.color.info}" },
    "subtle": { "bg": "{semantic.light.color.surface-alt}", "text": "{semantic.light.color.text-muted}" },
    "muted": { "text": "{semantic.light.color.text-muted}" }
  }
}
