{
  "model_profile": "adaptive",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "create_tag": false,
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "ai_integration_phase": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "assumptions",
    "skip_discuss": false,
    "_auto_chain_active": false,
    "discuss_comprehensive_research": true,
    "discuss_synthesize_when_user_delegates": true,
    "discuss_always_surface_for_user": [
      "semver_or_public_api_break",
      "security_model_vs_owasp_doc",
      "generator_or_host_contract_output"
    ],
    "use_worktrees": false
  },
  "sigra_defaults": {
    "audit_atomicity_doc": ".planning/AUDIT-ATOMICITY-DEFAULTS.md",
    "note": "Subagent-backed defaults from Phase 80 discuss; load for SEED-002 / audit Multi phases unless CONTEXT overrides."
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "mode": "yolo",
  "granularity": "fine",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-6-sol",
      "sonnet": "gpt-6-luna",
      "haiku": "gpt-6-luna"
    },
    "claude": {
      "opus": "claude-opus-5-5",
      "sonnet": "claude-opus-5-5",
      "haiku": "claude-sonnet-5-5"
    }
  }
}
