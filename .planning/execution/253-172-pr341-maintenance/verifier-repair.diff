+def compare_file_paths(compare):
+    files = compare.get("files") if isinstance(compare, dict) else None
+    # GitHub's compare endpoint caps files at 300, independently of commit-page
+    # size. A saturated response cannot establish completeness.
+    require(isinstance(files, list) and files and len(files) < 300
+            and all(isinstance(item, dict) and isinstance(item.get("filename"), str)
+                    and item["filename"] for item in files),
+            "compare file inventory is empty, malformed or incomplete")
+    paths = [item["filename"] for item in files]
+    require(len(set(paths)) == len(paths), "compare file inventory has duplicates")
+    return paths
+
