+      const expectedFullRef = identity?.ref ? `refs/heads/${identity.ref}` : null;
+      if (!remote || remote.status !== "ok" || remote.repository !== identity?.repository || remote.ref !== expectedFullRef || remote.sha !== identity?.sha) {
