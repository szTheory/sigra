+    .replace(/\btoken ([^ ;]+)/gi, "token [REDACTED]")
+    .replace(/\b[0-9a-f]{40,64}\b/gi, "[REDACTED_HEX]")
+    .replace(/(?:\\[0-9a-f]){40,64}/gi, "[REDACTED_ESCAPED_HEX]"));
