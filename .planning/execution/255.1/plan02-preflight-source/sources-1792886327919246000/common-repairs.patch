+      const [ref, oid, type, peeledOid, peeledType] = fixtureGit(repo, "for-each-ref", "--format=%(refname)%09%(objectname)%09%(objecttype)%09%(*objectname)%09%(*objecttype)", `refs/tags/${tag}`).split("\t");
