+def _redact(path: Path, password: str) -> None:
+    if not password or not path.is_file():
+        return
+    payload = path.read_bytes()
+    redacted = payload.replace(password.encode(), b"[REDACTED]")
+    if redacted != payload:
+        path.write_bytes(redacted)
