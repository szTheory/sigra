retries=0\n@@ -1430,6 +1597,37 @@ jobs:\n             test/example/priv/playwright/artifacts/\n           retention-days: 7\n           if-no-files-found: warn\n+      - name: Capture CI measurement metadata\n+        if: always()\n+        env:\n+          JOB_NAME: Example Playwright shard\n+          MATRIX_SEAM: ${{ matrix.seam }}\n+          CONFIGURED_NODE: '20'\n+          BROWSER_DEPS_CACHE_HIT: ${{ steps.boot.outputs.deps_cache_hit }}\n+          BROWSER_CACHE_HIT: ${{ steps.boot.outputs.browser_cache_hit }}\n+          DEPS_CACHE_HIT: ''\n+          EXAMPLE_DEPS_CACHE_HIT: ''\n+          INSTALL_DEPS_CACHE_HIT: ''\n+          HTTP_DEPS_CACHE_HIT: ''\n+        run: |\n+          node <<'NODE'\n+          const fs=require('node:fs');const{spawnSync}=require('node:child_process');\n+          const readTool=(name)=>{try{return fs.readFileSync('.tool-versions','utf8').split(/\\n/).find((line)=>line.trim().startsWith(`${name} `))?.trim().split(/\\s+/)[1]??null}catch{return null}};\n+          const capture=(command,args,pattern)=>{const result=spawnSync(command,args,{encoding:'utf8'});if(result.error?.code==='ENOENT')return{value:null,reason:'binary_missing'};if(result.status!==0)return{value:null,reason:'version_command_failed'};const line=`${result.stdout??''}\\n${result.stderr??''}`.split(/\\r?\\n/).map((s)=>s.trim()).find((s)=>pattern.test(s));return line?{value:line,reason:null}:{value:null,reason:'version_line_unrecognized'}};\n+          const elixir=capture('elixir',['--version'],/^Elixir v?[0-9.]+/);const otp=capture('elixir',['--version'],/^Erlang\\/OTP [0-9.]+/);const node=capture('node',['--version'],/^v[0-9.]+/);const playwright=capture('test/example/priv/playwright/node_modules/.bin/playwright',['--version'],/^(Version )?[0-9]+\\.[0-9]+\\.[0-9]+$/);\n+          let playwrightPin=null;try{playwrightPin=JSON.parse(fs.readFileSync('test/example/priv/playwright/package-lock.json','utf8')).packages['node_modules/@playwright/test'].version??null}catch{}