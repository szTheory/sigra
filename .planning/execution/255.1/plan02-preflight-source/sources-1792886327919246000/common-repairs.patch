+}
+
+function sourceRecord(endpoint, status, extra = {}, requestedAt = now()) {
+  return { endpoint, requested_at: requestedAt, completed_at: now(), status, ...extra };
+}
+
+function identityFromPull(pull) {
+  return {
+    number: Number(pull?.number),
