+    for (const match of text.matchAll(pattern)) {
+      const base = path.posix.normalize(path.posix.join(path.posix.dirname(file), match[1]));
+      const candidate = ['', '.ts', '.mjs', '.js', '.json', '/index.ts'].map((suffix) => base + suffix)
