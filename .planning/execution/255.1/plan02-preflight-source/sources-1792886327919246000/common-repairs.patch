+#!/usr/bin/env python3
+"""Install the locked Playwright OS packages without unbounded apt downloads.
+
+Only Ubuntu 24.04 amd64 is supported. Repository signatures and TLS verification
+remain enabled. Acquisition may retry once; package configuration never retries
+or receives this helper's wall-clock timeout.
+"""
+
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+import time
+import urllib.parse
+
+
+HOSTS = {"archive.ubuntu.com", "security.ubuntu.com", "azure.archive.ubuntu.com"}
+PACKAGE = re.compile(r"[a-z0-9][a-z0-9+.-]*\Z")
+SUITES = {"noble", "noble-updates", "noble-security", "noble-backports"}
+KEYRING = "/usr/share/keyrings/ubuntu-archive-keyring.gpg"
+
+
+def packages_from_dry_run(output: str) -> list[str]:
+    """Parse the public CLI's printed command as data, never execute its shell."""
+    if len(output) > 65536 or len(output.strip().splitlines()) != 1:
+        raise ValueError("unexpected_playwright_dry_run_output")
+    wrapper = shlex.split(output)
+    if wrapper[:4] == ["sudo", "--", "sh", "-c"] and len(wrapper) == 5:
+        command = wrapper[4]
+    elif wrapper[:2] == ["sh", "-c"] and len(wrapper) == 3:
+        command = wrapper[2]
+    else:
+        raise ValueError("unexpected_playwright_dry_run_wrapper")
+    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
+    lexer.whitespace_split = True
+    lexer.commenters = ""
+    tokens = list(lexer)
+    prefix = ["apt-get", "update", "&&", "apt-get", "install", "-y", "--no-install-recommends"]
+    packages = tokens[len(prefix):]
+    if tokens[:len(prefix)] != prefix or not packages or any(not PACKAGE.fullmatch(p) for p in packages):
+        raise ValueError("unexpected_playwright_apt_command")
+    if len(set(packages)) != len(packages):
+        raise ValueError("duplicate_playwright_package")
+    return packages
+
+
+def _official_uri(value: str) -> bool:
+    uri = urllib.parse.urlsplit(value)
+    return (uri.scheme in {"http", "https"} and uri.hostname in HOSTS
+            and not uri.username and not uri.password and uri.port is None
+            and uri.path.rstrip("/") == "/ubuntu" and not uri.query and not uri.fragment)
+
+
+def ubuntu_sources(original: str, mirrorlists: dict[str, str]) -> str:
+    """Retain each Ubuntu stanza, replacing only its URI field and continuations."""
+    result = []
+    for stanza in re.split(r"\n[ \t]*\n", original.strip()):
+        lines = stanza.splitlines()
+        fields = {}
+        spans = {}
+        current = None
+        for index, line in enumerate(lines):
+            if not line.strip() or line.lstrip().startswith("#"):
+                continue
+            if line.startswith((" ", "\t")):
+                if current is None:
+                    raise ValueError("invalid_ubuntu_sources_continuation")
+                fields[current] += " " + line.strip()
+                spans[current][1] = index + 1
+                continue
+            match = re.fullmatch(r"([A-Za-z][A-Za-z-]*):[ \t]*(.*)", line)
+            if not match or match[1].lower() in fields:
+                raise ValueError("invalid_ubuntu_sources_field")
+            current = match[1].lower()
+            fields[current] = match[2]
+            spans[current] = [index, index + 1]
+        if not fields:
+            result.append(stanza)
+            continue
+        required = {"types", "uris", "suites", "components", "signed-by"}
+        allowed = required | {"architectures", "languages", "targets", "enabled", "pdiffs", "by-hash"}
+        if not required <= fields.keys() or not fields.keys() <= allowed:
+            raise ValueError("unsupported_ubuntu_sources_fields")
+        if (not set(fields["types"].split()) <= {"deb", "deb-src"}
+                or not fields["types"].split()
+                or not set(fields["suites"].split()) <= SUITES or not fields["suites"].split()
+                or not set(fields["components"].split()) <= {"main", "restricted", "universe", "multiverse"}
+                or not fields["components"].split()
+                or fields["signed-by"].strip() != KEYRING
+                or fields.get("architectures", "amd64").split() != ["amd64"]
+                or fields.get("enabled", "yes") != "yes"):
+            raise ValueError("unsupported_ubuntu_sources_identity")
+        for uri in fields["uris"].split():
+            if uri in {"mirror+file:/etc/apt/apt-mirrors.txt", "mirror+file:/etc/apt/apt-security-mirrors.txt"}:
+                mirrorlist = mirrorlists.get(uri, "")
+                mirrors = [line.split()[0] for line in mirrorlist.splitlines()
+                           if line.strip() and not line.lstrip().startswith("#")]
+                if not mirrors or not all(_official_uri(item) for item in mirrors):
+                    raise ValueError("unrecognized_ubuntu_mirrorlist")
+            elif not _official_uri(uri):
+                raise ValueError("unrecognized_ubuntu_source_uri")
+        if not fields["uris"].split():
+            raise ValueError("missing_ubuntu_source_uri")
+        security_only = set(fields["suites"].split()) == {"noble-security"}
+        host = "security.ubuntu.com" if security_only else "archive.ubuntu.com"
+        start, end = spans["uris"]
+        lines[start:end] = [f"URIs: https://{host}/ubuntu/"]
+        result.append("\n".join(lines))
+    if not result or not any("URIs: https://" in stanza for stanza in result):
+        raise ValueError("no_ubuntu_sources")
+    return "\n\n".join(result) + "\n"
+
+
+def transient_acquisition(code: int, output: str) -> bool:
+    if re.search(r"NO_PUBKEY|GPG error|not signed|Certificate verification failed|Release file.*expired", output, re.I):
+        return False
+    return code in {124, 137} or bool(re.search(
+        r"Temporary failure resolving|Could not connect|Connection (?:failed|timed out)|"
+        r"TLS connection was non-properly terminated|(?:500|502|503|504) (?:Internal|Bad|Service|Gateway)",
+        output, re.I))
+
+
+def run_logged(argv: list[str], log: Path) -> int:
+    with log.open("x") as output:
+        return subprocess.run(argv, stdout=output, stderr=subprocess.STDOUT).returncode
+
+
+@contextmanager
+def apt_directory():
+    # apt creates root/_apt-owned files; only remove the directory we generated.
+    folder = Path(tempfile.mkdtemp(prefix="sigra-playwright-apt-"))
+    try:
+        folder.chmod(0o755)
+        yield folder
+    finally:
+        try:
+            shutil.rmtree(folder)
+        except PermissionError:
+            subprocess.run(["sudo", "--non-interactive", "rm", "--recursive", "--force",
+                            "--one-file-system", "--", str(folder)], check=True)
+
+
+def install(playwright_dir: Path, browsers: list[str], report_path: Path, *,
+            system_root: Path = Path("/"), runner=run_logged) -> int:
+    report = {"schema_version": "sigra.playwright-os-deps/v1", "status": "failed",
+              "browsers": browsers, "phases": [], "maximum_acquisition_attempts": 2,
+              "package_configuration_retried": False,
+              "retry_policy": "one fresh connection to the official HTTPS sources"}
+    if report_path.exists():
+        raise ValueError("report_already_exists")
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+
+    def save():
+        report_path.write_text(json.dumps(report, indent=2) + "\n")
+
+    def stage(name, attempt, argv):
+        log = report_path.with_name(report_path.stem + f".{attempt}.{name}.log")
+        started = time.monotonic()
+        code = runner(argv, log)
+        report["phases"].append({"phase": name, "attempt": attempt, "exit_code": code,
+                                 "elapsed_seconds": round(time.monotonic() - started, 3),
+                                 "log": str(log), "log_sha256": hashlib.sha256(log.read_bytes()).hexdigest()})
+        save()
+        return code, log.read_text(errors="replace")
+
+    try:
+        if not browsers or len(set(browsers)) != len(browsers) or not set(browsers) <= {"chromium", "webkit", "firefox"}:
+            raise ValueError("unsupported_browser_selection")
+        release = dict(line.split("=", 1) for line in (system_root/"etc/os-release").read_text().splitlines()
+                       if "=" in line and not line.startswith("#"))
+        if (platform.system() != "Linux" or platform.machine() != "x86_64"
+                or release.get("ID", "").strip('"') != "ubuntu"
+                or release.get("VERSION_ID", "").strip('"') != "24.04"):
+            raise ValueError("requires_ubuntu_24_04_amd64")
+        if not (system_root/KEYRING.lstrip("/")).is_file():
+            raise ValueError("ubuntu_archive_keyring_missing")
+        source = (system_root/"etc/apt/sources.list.d/ubuntu.sources").read_text()
+        mirrors = {}
+        for name in ("apt-mirrors.txt", "apt-security-mirrors.txt"):
+            path = system_root/"etc/apt"/name
+            if path.is_file():
+                mirrors[f"mirror+file:/etc/apt/{name}"] = path.read_text()
+        generated = ubuntu_sources(source, mirrors)
+        node = shutil.which("node")
+        cli = playwright_dir/"node_modules/playwright/cli.js"
+        if not node or not cli.is_file():
+            raise ValueError("locked_playwright_cli_missing")
+        # The public CLI derives package names for the actual host and selection.
+        code, dry_run = stage("package-plan", 0, [node, str(cli.resolve()), "install-deps", "--dry-run", *browsers])
+        if code:
+            return code
+        packages = packages_from_dry_run(dry_run)
+        report.update(packages=packages, original_sources_sha256=hashlib.sha256(source.encode()).hexdigest())
+        sudo = [] if os.geteuid() == 0 else ["sudo", "--non-interactive"]
+        with apt_directory() as temporary:
+            (temporary/"empty-sources").mkdir(mode=0o755)
+            (temporary/"lists").mkdir(mode=0o755)
+            (temporary/"archives").mkdir(mode=0o755)
+            for attempt in (1, 2):
+                sources = temporary/"ubuntu.sources"
+                sources.write_text(generated); sources.chmod(0o644)
+                env = ["env", "DEBIAN_FRONTEND=noninteractive"]
+                # Command-line options win over any later image apt.conf.d file.
+                options = {"Dir::Etc::sourcelist": sources,
+                           "Dir::Etc::sourceparts": temporary/"empty-sources",
+                           "Dir::State::lists": temporary/"lists",
+                           "Dir::Cache::archives": temporary/"archives",
+                           "Dir::Cache::pkgcache": "", "Dir::Cache::srcpkgcache": "",
+                           "Acquire::Retries": "0", "Acquire::http::Timeout": "15",
+                           "Acquire::https::Timeout": "15", "APT::Update::Error-Mode": "any"}
+                apt = ["/usr/bin/apt-get", *[arg for key, value in options.items()
+                       for arg in ("-o", f"{key}={value}")], "-y", "--no-install-recommends"]
+                failure = None
+                for name, seconds, arguments in (("update", 60, ["update"]),
+                                                 ("download", 240, ["--download-only", "install", *packages])):
+                    command = [*sudo, "timeout", "--signal=TERM", "--kill-after=10s", f"{seconds}s", *env, *apt, *arguments]
+                    code, output = stage(name, attempt, command)
+                    if code:
+                        failure = (code, output)
+                        break
+                if failure:
+                    if attempt == 1 and transient_acquisition(*failure):
+                        continue
+                    return failure[0]
+                # Every package is acquired and verified before dpkg can run.
+                # Do not put a kill timer around package configuration.
+                code, _ = stage("install", attempt, [*sudo, *env, *apt, "--no-download", "install", *packages])
+                if code:
+                    return code
+                report["status"] = "passed"
+                report["successful_acquisition_attempt"] = attempt
+                return 0
+        raise AssertionError("unreachable_acquisition_state")
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        report["status"] = "failed"
+        report["diagnostic"] = str(error)
+        return 1
+    finally:
+        save()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("browsers", nargs="+", choices=["chromium", "webkit", "firefox"])
+    parser.add_argument("--playwright-dir", type=Path, default=Path.cwd())
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    return install(args.playwright_dir.resolve(), args.browsers, args.report.resolve())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/ci/ci-playwright-os-deps.test.py b/scripts/ci/ci-playwright-os-deps.test.py
new file mode 100644
index 000000000..428d0d8a3
--- /dev/null
+++ b/scripts/ci/ci-playwright-os-deps.test.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""Hermetic acquisition/installation boundaries; no apt, sudo, or network."""
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("os_deps", Path(__file__).with_name("ci-playwright-os-deps.py"))
+deps = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(deps)
+
+SOURCE = """# Existing Ubuntu archive
+Types: deb
+URIs: mirror+file:/etc/apt/apt-mirrors.txt
+Suites: noble noble-updates noble-backports
+Components: main restricted universe multiverse
+Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
+
+Types: deb
+URIs: http://security.ubuntu.com/ubuntu/
+Suites: noble-security
+Components: main restricted universe multiverse
+Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
+"""
+MIRRORS = "http://azure.archive.ubuntu.com/ubuntu/\tpriority:1\nhttps://archive.ubuntu.com/ubuntu/\tpriority:2\n"
+MIRRORLISTS = {"mirror+file:/etc/apt/apt-mirrors.txt": MIRRORS,
+               "mirror+file:/etc/apt/apt-security-mirrors.txt": MIRRORS}
+PLAN = 'sudo -- sh -c "apt-get update&& apt-get install -y --no-install-recommends libflite1 libasound2t64 fonts-liberation"\n'
+
+
+class OsDependencies(unittest.TestCase):
+    def test_public_cli_command_is_data_and_exact_packages_are_retained(self):
+        self.assertEqual(deps.packages_from_dry_run(PLAN), ["libflite1", "libasound2t64", "fonts-liberation"])
+        self.assertEqual(deps.packages_from_dry_run(PLAN.replace("sudo -- ", "")),
+                         ["libflite1", "libasound2t64", "fonts-liberation"])
+
+    def test_unknown_shell_forms_and_injections_fail_closed(self):
+        for value in [PLAN + "notice\n", PLAN.replace("&&", ";"),
+                      PLAN.replace("libflite1", "libflite1; touch /tmp/injected"),
+                      PLAN.replace("libflite1", "$(whoami)"),
+                      PLAN.replace("libflite1", "--allow-unauthenticated"),
+                      PLAN.replace("libflite1", "libflite1 libflite1"),
+                      PLAN.replace("apt-get update", "echo apt-get update"),
+                      PLAN.replace("sudo -- sh", "sudo sh"),
+                      PLAN.replace("libflite1", "libflite1 #comment")]:
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                deps.packages_from_dry_run(value)
+
+    def test_sources_change_only_uri_and_keep_signature_and_suite_fields(self):
+        first = deps.ubuntu_sources(SOURCE, MIRRORLISTS)
+        self.assertIn("URIs: https://archive.ubuntu.com/ubuntu/", first)
+        self.assertIn("URIs: https://security.ubuntu.com/ubuntu/", first)
+        original_other = [line for line in SOURCE.splitlines() if not line.startswith("URIs:")]
+        for output in [first]:
+            self.assertEqual(original_other, [line for line in output.splitlines() if not line.startswith("URIs:")])
+            self.assertNotIn("Trusted:", output)
+
+    def test_standard_security_mirrorlist_is_validated_and_resolved(self):
+        source = SOURCE.replace("http://security.ubuntu.com/ubuntu/",
+                                "mirror+file:/etc/apt/apt-security-mirrors.txt")
+        self.assertEqual(deps.ubuntu_sources(source, MIRRORLISTS), deps.ubuntu_sources(SOURCE, MIRRORLISTS))
+        with self.assertRaisesRegex(ValueError, "mirrorlist"):
+            deps.ubuntu_sources(source, {"mirror+file:/etc/apt/apt-mirrors.txt": MIRRORS})
+
+    def test_unrecognized_sources_and_security_overrides_are_rejected(self):
+        for source, mirrors in [(SOURCE.replace("noble-updates", "jammy-updates"), MIRRORS),
+                                (SOURCE.replace("Signed-By:", "Trusted:"), MIRRORS),
+                                (SOURCE + "Trusted: yes\n", MIRRORS),
+                                (SOURCE.replace("http://security.ubuntu.com/ubuntu/", "https://evil.example/ubuntu/"), MIRRORS),
+                                (SOURCE, "https://evil.example/ubuntu/\n"),
+                                (SOURCE.replace("http://security.ubuntu.com/ubuntu/", "https://user:pass@security.ubuntu.com/ubuntu/"), MIRRORS),
+                                (SOURCE.replace("http://security.ubuntu.com/ubuntu/", "https://security.ubuntu.com/ubuntu/?override=1"), MIRRORS)]:
+            with self.subTest(source=source), self.assertRaises(ValueError):
+                deps.ubuntu_sources(source, {key: mirrors for key in MIRRORLISTS})
+
+    def fixture(self, folder):
+        root = Path(folder)/"system"
+        (root/"etc/apt/sources.list.d").mkdir(parents=True)
+        (root/"etc/os-release").write_text('ID=ubuntu\nVERSION_ID="24.04"\n')
+        (root/"etc/apt/sources.list.d/ubuntu.sources").write_text(SOURCE)
+        (root/"etc/apt/apt-mirrors.txt").write_text(MIRRORS)
+        key = root/deps.KEYRING.lstrip("/"); key.parent.mkdir(parents=True); key.write_bytes(b"retained-keyring")
+        playwright = Path(folder)/"playwright"
+        (playwright/"node_modules/playwright").mkdir(parents=True)
+        (playwright/"node_modules/playwright/cli.js").write_text("// public CLI fixture\n")
+        return root, playwright
+
+    def scenario(self, outcomes):
+        with tempfile.TemporaryDirectory() as folder:
+            root, playwright = self.fixture(folder)
+            calls = []
+            def runner(argv, log):
+                calls.append(argv)
+                if "--dry-run" in argv:
+                    log.write_text(PLAN)
+                    return 0
+                code, output = outcomes.pop(0)
+                self.assertFalse(any("Dl-Limit" in arg or "Verify-Peer" in arg for arg in argv))
+                for key in ["Dir::State::lists=", "Dir::Cache::archives=", "Dir::Etc::sourceparts="]:
+                    self.assertTrue(any(arg.startswith(key) for arg in argv))
+                self.assertIn("/usr/bin/apt-get", argv)
+                self.assertIn("Acquire::Retries=0", argv)
+                self.assertIn("APT::Update::Error-Mode=any", argv)
+                log.write_text(output)
+                return code
+            report = Path(folder)/"result.json"
+            with patch.object(deps.platform, "system", return_value="Linux"), \
+                 patch.object(deps.platform, "machine", return_value="x86_64"), \
+                 patch.object(deps.shutil, "which", return_value="/usr/bin/node"), \
+                 patch.object(deps.os, "geteuid", return_value=1001):
+                code = deps.install(playwright, ["chromium", "webkit"], report, system_root=root, runner=runner)
+            self.assertEqual((root/"etc/apt/sources.list.d/ubuntu.sources").read_text(), SOURCE)
+            self.assertEqual((root/"etc/apt/apt-mirrors.txt").read_text(), MIRRORS)
+            return code, json.loads(report.read_text()), calls
+
+    def test_success_acquires_before_install_and_install_has_no_kill_timer(self):
+        code, report, calls = self.scenario([(0, "updated"), (0, "downloaded"), (0, "configured")])
+        self.assertEqual(code, 0)
+        self.assertEqual(report["status"], "passed")
+        self.assertEqual([x["phase"] for x in report["phases"]], ["package-plan", "update", "download", "install"])
+        self.assertIn("timeout", calls[1]); self.assertIn("timeout", calls[2])
+        self.assertIn("--download-only", calls[2]); self.assertIn("--no-download", calls[3])
+        self.assertNotIn("timeout", calls[3]); self.assertNotIn("--foreground", sum(calls, []))
+        self.assertEqual(calls[3][-3:], ["libflite1", "libasound2t64", "fonts-liberation"])
+
+    def test_one_acquisition_retry_then_success_does_not_repeat_install(self):
+        code, report, calls = self.scenario([(0, "updated"), (124, "slow acquisition"),
+                                            (0, "updated fallback"), (0, "downloaded"), (0, "configured")])
+        self.assertEqual(code, 0)
+        self.assertEqual(report["successful_acquisition_attempt"], 2)
+        self.assertEqual(sum("--no-download" in argv for argv in calls), 1)
+        self.assertEqual([x["exit_code"] for x in report["phases"]], [0, 0, 124, 0, 0, 0])
+
+    def test_exhausted_acquisition_keeps_last_exit_and_never_starts_dpkg(self):
+        code, report, calls = self.scenario([(124, "slow index"), (137, "stalled fallback")])
+        self.assertEqual(code, 137)
+        self.assertEqual(report["status"], "failed")
+        self.assertFalse(any("--no-download" in argv for argv in calls))
+        self.assertEqual([x["exit_code"] for x in report["phases"]], [0, 124, 137])
+
+    def test_security_error_and_install_error_never_retry(self):
+        code, report, calls = self.scenario([(100, "GPG error: repository is not signed")])
+        self.assertEqual(code, 100); self.assertEqual(len(calls), 2)
+        code, report, calls = self.scenario([(0, "updated"), (0, "downloaded"), (100, "dpkg failure")])
+        self.assertEqual(code, 100); self.assertEqual(len(calls), 4)
+        self.assertFalse(report["package_configuration_retried"])
+
+    def test_network_errors_retry_but_unknown_errors_do_not(self):
+        self.assertTrue(deps.transient_acquisition(100, "Temporary failure resolving archive.ubuntu.com"))
+        self.assertTrue(deps.transient_acquisition(100, "503 Service Unavailable"))
+        self.assertFalse(deps.transient_acquisition(100, "Unable to locate package libflite1"))
+        self.assertFalse(deps.transient_acquisition(124, "Certificate verification failed"))
+
+
+if __name__ == "__main__":
+    unittest.main()
