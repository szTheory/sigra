+_SERVER_PARENT_PAGE: dict = {}
+
+
+def load_server_parent_page(root: Path = ROOT) -> dict:
+    """253-155: the decoded real page 1 of main's check runs (R12 ledger sequence 21) and the sha256 of the ledger file."""
+    if "value" not in _SERVER_PARENT_PAGE:
+        raw = (root / R12_LEDGER_REL).read_bytes()
+        row = next(row for row in json.loads(raw)["transactions"] if row.get("sequence") == R12_CHECK_RUNS_SEQUENCE)
+        if row.get("route_id") != "check_runs" or row.get("page_ordinal") != 1 or row.get("actual_status") != 200:
+            raise RuntimeError("R12 ledger sequence 21 is not the check_runs page 1 that 253-143 read")
+        body = json.loads(base64.b64decode(row["response_body_base64"], validate=True))
+        _SERVER_PARENT_PAGE["value"] = {"path": R12_LEDGER_REL, "sha256": sha256_hex(raw), "sequence": R12_CHECK_RUNS_SEQUENCE,
+                                        "body": body}
+    return _SERVER_PARENT_PAGE["value"]
+
+
+def server_parent_check_runs(sha: str, total: int, page: dict | None = None) -> list:
+    """253-155: the server parent's total check runs. Page 1 is the real page 253-143 read (R12 ledger sequence 21) with
+    every run's head_sha rewritten to sha and nothing else changed. The rest are deterministic synthetic runs: one more
+    same-app duplicate of every required name, then other checks, with ids below the smallest page-1 id (page 1 stays newest)."""
+    body = (page or load_server_parent_page())["body"]
+    real = copy.deepcopy(body["check_runs"])
+    if body.get("total_count") != total or len(real) > total:
+        raise RuntimeError(f"the real page 1 carries total_count {body.get('total_count')}, not {total}")
+    for run in real:
+        run["head_sha"] = sha
+    lowest = min(run["id"] for run in real)
+    names = list(REQUIRED_CHECKS) + [f"Other check {index}" for index in range(len(REQUIRED_CHECKS), total - len(real))]
+    synthetic = [{"id": lowest - 1 - index, "name": name, "head_sha": sha, "status": "completed", "conclusion": "success",
+                  "html_url": f"https://github.com/{REPO}/actions/runs/600000/job/{lowest - 1 - index}",
+                  "app": dict(APP)} for index, name in enumerate(names)]
+    return real + synthetic
+
+
+def paged_listing(body: dict, key: str, page: int, base: str) -> tuple:
+    """253-165: page 1 or 2 of a two-page listing. Page 1 holds the first half (rounded up), page 2 the rest; both carry
+    the unpaged total_count. Page 1's Link is rel next+last, page 2's rel prev+first, as GitHub sends them."""
+    items = list(body.get(key) or [])
+    half = (len(items) + 1) // 2
+    page_body = dict(body)
+    page_body[key] = items[:half] if page == 1 else items[half:]
+    rels = [(2, "next"), (2, "last")] if page == 1 else [(1, "prev"), (1, "first")]
+    return page_body, ", ".join(f'<{base}?per_page=100&page={target}>; rel="{rel}"' for target, rel in rels)
+
+
+def paginated_reads(ledger: dict) -> list:
+    """253-146: every multi-page read in the window ledger, in order: {route, pages, next_link_forms}, where a form is
+    "repositories-id" (GitHub's /repositories/<id>/ link) or "repos" (the /repos/<owner>/<repo>/ link), read from the
+    scrubbed rel=next destinations."""
+    reads, current = [], None
+    for row in ledger.get("transactions", []):
+        if (row.get("hop_ordinal") or 0) != 0:
+            continue
+        page = row.get("page_ordinal")
+        if current is not None and row.get("route_id") == current["route"] and page == current["pages"] + 1:
+            current["pages"] += 1
+        else:
+            current = {"route": row.get("route_id"), "pages": 1, "next_link_forms": []}
+            reads.append(current)
+        for entry in (row.get("scrubbed_headers") or {}).get("link") or []:
+            path = ((entry or {}).get("destination") or {}).get("path") or ""
+            if (entry or {}).get("rel") != "next":
+                continue
+            form = "repositories-id" if path.startswith("/repositories/") else "repos" if path.startswith("/repos/") else "other"
+            if form not in current["next_link_forms"]:
+                current["next_link_forms"].append(form)
+    return [read for read in reads if read["pages"] > 1]
+
+
+def start_fake(work: Path, clone: Path, ledger: Path, journal: Path, server_parent: str, verifier_module,
+               visibility_delay: float, polls: dict, seed_legacy: bool, live: bool = False, seed_refs: dict | None = None,
+               repos_link_form: bool = False, paged_listings: bool = False):
+    cert, key = work / "tls-cert.pem", work / "tls-key.pem"
+    # Live-policy mode: a certificate for the real hostnames, so SNI and hostname verification use them (253-108).
+    names = LIVE_TLS_NAMES if live else ("localhost",)
+    run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1",
+         "-subj", "/CN=" + ("sigra-live-policy-dry-run" if live else "localhost"),
+         "-addext", "subjectAltName=" + ",".join(f"DNS:{name}" for name in names), "-keyout", str(key), "-out", str(cert)])
+    server = FakeServer(("127.0.0.1", 0), FakeGitHub)
+    server.live = live
+    server.repos_link_form = bool(live and repos_link_form)
+    server.paged_listings = bool(paged_listings)
+    server.authorization = {"api_with": 0, "api_without": 0, "blob_with": 0, "results_receiver_with": 0}
+    server.log_tokens = {}
+    server.work = str(work)
+    server.git_dir = str(work / "fake-github.git")
+    run(["git", "init", "--bare", "-q", server.git_dir])
+    (Path(server.git_dir) / "objects/info/alternates").write_text(str(clone / ".git/objects") + "\n")
+    server.journal, server.violations, server.lock = [], [], threading.Lock()
+    server.journal_path, server.ledger_path = str(journal), str(ledger)
+    server.blobs, server.trees, server.tree_entries = LazyBlobs(server), LazyTrees(server), {}
+    server.commits, server.refs, server.flags, server.last_body = {}, {}, {}, b""
+    server.parent_sha = server.server_parent = server_parent
+    raw = run(["git", "-C", str(clone), "cat-file", "commit", server_parent]).stdout
+    head, message = raw.split(b"\n\n", 1)
+    lines = head.decode().splitlines()
+    server.commits[server_parent] = {"sha": server_parent, "tree": {"sha": next(l.split()[1] for l in lines if l.startswith("tree "))},
+                                     "parents": [{"sha": l.split()[1]} for l in lines if l.startswith("parent ")],
+                                     "message": message.decode(), "author": {}, "committer": {}}
+    if seed_legacy:
+        server.refs.update(LEGACY_REFS)
+    if seed_refs:
+        server.refs.update(seed_refs)
+    server.seeded = dict(server.refs)
+    server.rules = [{"type": "required_status_checks", "ruleset_source_type": "Repository", "ruleset_source": REPO,
+                     "ruleset_id": 4242424, "parameters": {"strict_required_status_checks_policy": False,
+                                                          "do_not_enforce_on_create": False,
+                                                          "required_status_checks": [{"context": name, "integration_id": APP["id"]}
+                                                                                     for name in REQUIRED_CHECKS]}},
+                    {"type": "deletion", "ruleset_source_type": "Repository", "ruleset_source": REPO, "ruleset_id": 4242424}]
+    server.runs, server.run_seq = {}, 0
+    server.run_base = 40000000000 + int.from_bytes(os.urandom(3), "big") * 100
+    server.visibility_delay, server.polls = visibility_delay, polls
+    server.artifact_ids, server.blobs_by_artifact = {}, {}
+    server.verifier_module = verifier_module
+    server.verifier_job = None
+    server.inject = {}
+    server.last_rate_at = time.monotonic()
+    tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    tls.load_cert_chain(cert, key)
+    server.socket = tls.wrap_socket(server.socket, server_side=True)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    return server, thread, cert
