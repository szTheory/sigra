+
+function separateXtrace(text) {
+  const lines = text.split(/\r?\n/);
+  const xtrace = lines.filter((line) => /^\+{1,}\d+s pid=\d+ line=\d+: /.test(line));
+  const output = lines.filter((line) => !/^\+{1,}\d+s pid=\d+ line=\d+: /.test(line));
