+chmod 755 "${FAKE_GIT_BIN}/git"
+PINNED_VERIFY_OUTPUT="$(PATH="${FAKE_GIT_BIN}:${PATH}" bash -c 'source "$1"; sigra_coordinator_pin_git; printf "git=%s version=%s\n" "$SIGRA_COORDINATOR_GIT_PATH" "$(git --version)"' _ "$COORDINATOR" 2>&1)" \
